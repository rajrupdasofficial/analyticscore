generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  COMPLETED
  CANCELLED
}

enum ActivityType {
  USER_CREATED
  USER_READ
  USER_UPDATED
  USER_DELETED

  PRODUCT_CREATED
  PRODUCT_READ
  PRODUCT_UPDATED
  PRODUCT_DELETED

  PURCHASE_SUCCESS
  PURCHASE_FAILED

  STOCK_RESTOCKED

  REVIEW_CREATED
  CART_ITEM_ADDED
  CART_ITEM_REMOVED
  CART_CLEARED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  INVENTORY_MOVED
}

enum InventoryMovementType {
  SALE
  RESTOCK
  ADJUSTMENT
  RESERVATION
  RELEASE
  RETURN
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  NET_BANKING
  WALLET
  COD
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  logs      ActivityLog[]
  cart      Cart?
  reviews   Review[]

  @@index([createdAt])
  @@index([isActive])
}

model Product {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  description String?
  category    String

  price       Decimal  @db.Decimal(12, 2)

  stock       Int      @default(0)
  minStock    Int      @default(10)

  isActive    Boolean  @default(true)
  deletedAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  cartItems          CartItem[]
  reviews            Review[]

  @@index([category])
  @@index([stock])
  @@index([isActive, deletedAt])
  @@index([createdAt])
}

model Order {
  id          String      @id @default(uuid())
  userId      String

  totalAmount Decimal     @db.Decimal(14, 2)

  status      OrderStatus @default(COMPLETED)

  createdAt   DateTime    @default(now())

  user                 User                 @relation(fields: [userId], references: [id])
  items                OrderItem[]
  payment              Payment?
  inventoryMovements   InventoryMovement[]

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(uuid())

  orderId   String
  productId String

  quantity  Int

  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(14, 2)

  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([orderId])
}

model ActivityLog {
  id        BigInt       @id @default(autoincrement())

  userId    String?
  type      ActivityType

  entityId  String?

  details   Json

  createdAt DateTime     @default(now())

  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([entityId])
  @@index([createdAt])
}

model InventoryMovement {
  id           String                @id @default(uuid())
  productId    String
  orderId      String?
  quantity     Int
  type         InventoryMovementType
  reason       String?
  balanceAfter Int
  createdAt    DateTime              @default(now())

  product      Product               @relation(fields: [productId], references: [id])
  order        Order?                @relation(fields: [orderId], references: [id])

  @@index([productId, createdAt])
  @@index([orderId])
  @@index([type, createdAt])
  @@index([createdAt])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]

  @@index([userId])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int
  title     String?
  body      String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([productId, rating])
  @@index([userId])
  @@index([createdAt])
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique
  amount        Decimal       @db.Decimal(14, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?
  failureReason String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order         Order         @relation(fields: [orderId], references: [id])

  @@index([status, createdAt])
  @@index([method])
  @@index([createdAt])
}
